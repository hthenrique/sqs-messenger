# Configuracoes de deploy AWS
AWS_REGION=us-east-1
APP_NAME=sqs-email-messenger

# Configuracoes SMTP (exemplo com Gmail App Password - 100% gratuito)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app-de-16-digitos
SMTP_FROM=seu-email@gmail.com
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
